{
  "manifest_version": 3,
  "name": "ABES WiFi Auto Login",
  "version": "4.3.0",
  "description": "Automatically logs in to the ABES-EC Internet Service Portal only while connected to the college network.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://192.168.1.254:8090/*",
    "https://www.abes.ac.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ABES WiFi Auto Login"
  },
  "content_scripts": [
    {
      "matches": [
        "https://192.168.1.254:8090/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
